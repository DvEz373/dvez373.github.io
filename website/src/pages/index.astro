---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Photo from "../components/Photo.astro";
import SectionHead from "../components/SectionHead.astro";
import Instrument from "../components/Instrument.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Schematic from "../components/Schematic.astro";
import portrait from "../assets/photos/portrait.jpg";
import { getProfile, getProjects, TONE, CV_FILE } from "../lib/content";
import { url } from "../lib/url";

const profile = await getProfile();
const projects = await getProjects();
const selected = projects.filter((p) => p.data.featured).slice(0, 4);
const focus = new Intl.ListFormat("en-GB", { type: "conjunction" }).format(profile.focus);
---

<Base description={`${profile.name}: ${profile.headline} in ${profile.city}, learning across ${focus}.`}>
  <section class="hero" aria-labelledby="hero-name">
    <div class="wrap grid">
      <div class="intro">
        <p class="label eyebrow">{profile.city}, {profile.country}</p>
        <h1 id="hero-name" class="name serif">{profile.name}</h1>
        <p class="headline">
          <span>{profile.headline}</span>
          <span class="accent">{profile.headlineAccent}</span>
        </p>
        <p class="now">
          <span class="live-dot" aria-hidden="true"></span>
          <span>Learning across {focus}</span>
        </p>
        <div class="actions">
          <a class="btn primary" href={url(CV_FILE)} download><Icon name="download" />Download CV</a>
          <a class="btn" href={url("about/#contact")}><Icon name="mail" />Get in touch</a>
        </div>
      </div>

      <div class="portrait-wrap">
        <Photo src={portrait} alt={`Portrait of ${profile.name}`} widths={[280, 420, 600]} sizes="(min-width: 960px) 360px, 60vw" ratio="1" eager class="portrait">
        </Photo>
      </div>
    </div>
    <Schematic variant="turbine" />
  </section>

  {
    selected.length > 0 && (
      <section class="section" aria-labelledby="s-work">
        <div class="wrap">
          <SectionHead title="Selected work" id="s-work" note="Client studies in power system modelling, control and AI" />
          <ul class="work">
            {selected.map((p) => (
              <li class={TONE[p.data.category]}>
                <ProjectCard entry={p} />
              </li>
            ))}
          </ul>
          <p class="all">
            <a class="btn" href={url("projects/")}>
              All {projects.length} projects <span aria-hidden="true">→</span>
            </a>
          </p>
        </div>
      </section>
    )
  }

  <section class="section" aria-labelledby="s-about">
    <div class="wrap">
      <SectionHead title="About" id="s-about" />
      <div class="about">
        <p>{profile.bio[1]}</p>
        <p>{profile.bio[2]}</p>
        <a class="btn" href={url("about/")}>More about me <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="s-demo">
    <div class="wrap">
      <SectionHead title="Interactive demo" id="s-demo" note="How a controller stabilises grid frequency after a generator trips" />
      <Instrument />
    </div>
  </section>
</Base>

<style>
  .work {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 20px;
  }
  @media (min-width: 760px) {
    .work {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .all {
    margin: 24px 0 0;
  }
  .about {
    display: grid;
    gap: 20px;
    justify-items: start;
    max-width: 68ch;
  }
  .about p {
    margin: 0;
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--ink-2);
  }
  /* The hero already ends in white space; the first section does not need its full top padding. */
  .hero + .section {
    padding-top: clamp(24px, 4vw, 48px);
  }
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(36px, 7vw, 96px) clamp(28px, 5vw, 64px);
  }
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 24px 24px;
    mask-image: radial-gradient(ellipse 80% 70% at 60% 40%, #000 30%, transparent 75%);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
  }
  .name {
    font-size: clamp(2.6rem, 1.4rem + 5vw, 5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    margin: 14px 0 18px;
  }
  /* Each part starts with a separator dot. The row is shifted left by one dot and that strip is
     clipped, so when the accent wraps onto its own line (phones) its dot never shows. */
  .headline {
    display: flex;
    flex-wrap: wrap;
    font-size: clamp(1.35rem, 1.1rem + 1.1vw, 2rem);
    line-height: 1.25;
    letter-spacing: -0.01em;
    font-weight: 500;
    margin: 0 0 18px -1em;
    clip-path: inset(0 0 0 1em);
  }
  .headline > span::before {
    content: "·" / "";
    display: inline-block;
    width: 1em;
    text-align: center;
    color: var(--line-strong);
  }
  .headline .accent {
    color: var(--signal);
  }
  .now {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 12px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--panel);
    font-size: 0.9rem;
    color: var(--ink-2);
    margin-bottom: 28px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .portrait-wrap {
    justify-self: end;
    width: min(100%, 380px);
  }
  .portrait-wrap :global(.frame) {
    border-radius: var(--radius-l);
    box-shadow: var(--shadow);
  }
  .hero :global(.schematic) {
    right: auto;
    left: -120px;
    top: auto;
    bottom: -40px;
    width: 420px;
    opacity: 0.12;
  }
  @media (max-width: 959px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .portrait-wrap {
      order: -1;
      justify-self: start;
      width: min(100%, 260px);
    }
    .hero :global(.schematic) {
      left: auto;
      right: -160px;
      bottom: auto;
      top: 10px;
    }
  }
</style>
